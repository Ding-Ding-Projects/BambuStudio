{
  "info": {
    "_postman_id": "7560ee71-b311-4bc4-a9c9-e70c5999446c",
    "name": "Bambu Studio - Master API Collection",
    "description": "Master index of HTTP contracts served by Bambu Studio. It contains the five-minute Home Assistant printer-discovery endpoint and the loopback-only local printer status API. Defaults are non-routable TEST-NET placeholders. Never save or export real pairing tokens, status API tokens, printer access codes, or response bodies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Home Assistant printer discovery",
      "description": "Temporary local-LAN handover created only while File > Smart home > Share for discovery is enabled.",
      "item": [
        {
          "name": "Authorized printer offer",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{pairing_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://{{share_host}}:{{share_port}}/bambustudio/printers",
              "protocol": "http",
              "host": [
                "{{share_host}}"
              ],
              "port": "{{share_port}}",
              "path": [
                "bambustudio",
                "printers"
              ]
            },
            "description": "Authenticated GET for the current sharing window. This is clear-text LAN HTTP; use only on a trusted broadcast domain, never expose it to a WAN, and turn sharing off immediately after verification."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is bounded and non-cacheable', function () {",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.printers).to.be.an('array').with.length.at.most(32);",
                  "  body.printers.forEach(function (printer) {",
                  "    ['serial', 'host', 'access_code'].forEach(function (field) {",
                  "      pm.expect(printer[field], field).to.be.a('string').and.not.empty;",
                  "      pm.expect(printer[field].length, field + ' length').to.be.at.most(256);",
                  "    });",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Local printer status API",
      "description": "Off-by-default, loopback-only, read-only API for the printer list and the beta door state. Details: docs/features/device/status-api.md.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://127.0.0.1:{{status_port}}/api/v1/health",
              "protocol": "http",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "port": "{{status_port}}",
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "description": "Authenticated liveness check.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{status_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is not cacheable and has no CORS header', function () {",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');",
                  "  pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(undefined);",
                  "});",
                  "pm.test('Body reports api_version 1', function () {",
                  "  pm.expect(pm.response.json().api_version).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        },
