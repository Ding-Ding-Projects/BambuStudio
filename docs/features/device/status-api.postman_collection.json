  ],
  "variable": [
    {
      "key": "status_port",
      "value": "18787",
      "type": "string",
      "description": "The port set under Preferences > Local status API."
    },
    {
      "key": "status_token",
      "value": "replace-in-a-disposable-local-environment",
      "type": "string",
      "description": "The access token from Preferences > Local status API. Never save or export the real value."
    },
    {
      "key": "dev_id",
      "value": "REPLACE_WITH_A_PRINTER_SERIAL",
      "type": "string",
      "description": "A dev_id from the printer list."
    }
  ]
}
