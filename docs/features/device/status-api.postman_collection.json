{
  "info": {
    "_postman_id": "3f0f6a52-6d0b-4a6e-9c53-2b8f1a4d7e10",
    "name": "Bambu Studio - Local Printer Status API",
    "description": "Contract checks for the off-by-default, loopback-only, read-only printer status API. Switch it on under Preferences > Local status API, then set status_port, status_token and dev_id in a disposable local environment. Never save or export the real token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:{{status_port}}/api/v1/health",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "{{status_port}}",
          "path": [
            "api",
            "v1",
            "health"
          ]
        },
        "description": "Authenticated liveness check.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{status_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is not cacheable and has no CORS header', function () {",
              "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');",
              "  pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(undefined);",
              "});",
              "pm.test('Body reports api_version 1', function () {",
              "  pm.expect(pm.response.json().api_version).to.eql(1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List printers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:{{status_port}}/api/v1/printers",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "{{status_port}}",
          "path": [
            "api",
            "v1",
            "printers"
          ]
        },
        "description": "The printers listed under My devices.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{status_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is not cacheable and has no CORS header', function () {",
              "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');",
              "  pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(undefined);",
              "});",
              "pm.test('printers is an array', function () {",
              "  pm.expect(pm.response.json().printers).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Door state",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:{{status_port}}/api/v1/printers/{{dev_id}}/door",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "{{status_port}}",
          "path": [
            "api",
            "v1",
            "printers",
            "{{dev_id}}",
            "door"
          ]
        },
        "description": "Beta door reading from bit 23 of home_flag or print.stat.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{status_token}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is not cacheable and has no CORS header', function () {",
              "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');",
              "  pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(undefined);",
              "});",
              "pm.test('Door state is open, closed or unknown', function () {",
              "  const b = pm.response.json();",
              "  pm.expect(['open','closed','unknown']).to.include(b.state);",
              "  pm.expect(b.beta).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
