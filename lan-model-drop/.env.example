# Copy this file to .env next to compose.yaml and change what you need.
# Every setting is optional; an empty value means the default.
# Never share your .env: it can hold the station key.

# Port on this computer that people open, for example http://<this computer's address>:8833
DROP_PORT=8833

# Name shown on the page ("Sending to ..."), at most 60 characters.
DROP_STATION_NAME=Bambu Studio

# Largest model accepted, in bytes (268435456 = 256 MB).
DROP_MAX_BYTES=268435456

# Hours a model waits for Bambu Studio before it is removed (at most 720).
DROP_TTL_HOURS=24

# Most models and bytes waiting at once (2147483648 = 2 GB).
DROP_QUEUE_MAX_FILES=50
DROP_QUEUE_MAX_BYTES=2147483648

# Station key Bambu Studio uses to collect models: 16 to 512 visible
# characters without spaces. Leave empty to have one generated on the first
# start and kept in the data volume; print it with
#   docker compose exec lan-model-drop node server/station-key.mjs
DROP_STATION_KEY=

# Fixed drop code, 4 to 12 digits. Leave empty for a random 6-digit code that
# Bambu Studio can renew ("New link"); a fixed code cannot be renewed there.
DROP_CODE=

# Address people open when the page sits behind a reverse proxy or has a
# fixed name, for example https://drop.example.org. It must be http or https,
# without a user name, password, query or fragment. Bambu Studio uses it for
# invite links and QR codes. Leave empty to use this computer's address.
DROP_PUBLIC_URL=
